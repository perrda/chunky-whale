{
  "name": "STACKHOUSE",
  "install": "npm ci && ([ -f .env.local ] || printf 'NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001\n' > .env.local)",
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev -- --port 3001",
      "description": "Next.js dev server (Turbopack) on http://127.0.0.1:3001"
    }
  ],
  "ports": [
    { "name": "web", "port": 3001 }
  ]
}
